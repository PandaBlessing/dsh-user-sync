# 本地凭据模板：复制成 .env.local 后填值（.env.local 已被 .gitignore 忽略）
# 用法：cp .env.local.example .env.local && chmod 600 .env.local
#
# npm 发布 token：npm 后台 → Access Tokens → Generate New Token（Granular 或 Classic）
# 注意：写进这里之后不要再贴进对话、截图或提交。
NPM_TOKEN=

# 可选：CI 里用 secret 注入同名环境变量即可，优先级高于 .env.local
# 可选：自定义发布目标（默认 https://registry.npmjs.org/）
# NPM_REGISTRY=https://registry.npmjs.org/
